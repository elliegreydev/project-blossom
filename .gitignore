# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android TWA wrapper (Bubblewrap)
# NEVER commit the signing keystore - it is the key that proves builds are
# genuinely from us. Build outputs are regenerated, so they are noise.
android/*.keystore
android/*.jks
android/*.keystore.md5
android/.gradle/
android/build/
android/app/build/
android/*.aab
android/*.apk

# playwright browsers are machine-local, installed on demand
/test-results/
